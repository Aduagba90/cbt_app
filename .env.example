# ---------------------------------------------------------------------------
# PrepNova CBT — environment configuration
#
# LOCAL TESTING:  you do NOT need this file at all.  Just run:  python app.py
#                 (development mode: temporary secret key, admin@gmail.com / admin123)
#
# PRODUCTION:     copy this file to .env, fill in the values marked REQUIRED,
#                 and run with gunicorn (see README).  NEVER commit .env to git.
#
# Note: put comments on their own line — text after a value is read as part of it.
# ---------------------------------------------------------------------------

# "production" (default under gunicorn/hosting) or "development" (default for python app.py)
FLASK_ENV=production

# REQUIRED in production, 32+ random characters.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public URL of the site (used in e-mails and the Paystack callback), no trailing slash
APP_URL=https://your-domain.com
PORT=5000

# Database file. In production use an absolute path on a persistent disk.
# Leave empty to use the database.db that ships with the repo.
DATABASE_PATH=
# SQLite journal. WAL (default) on a normal disk; DELETE on network storage such as PythonAnywhere
# (set automatically there).
SQLITE_JOURNAL_MODE=

# Administrator login for /admin_login  (REQUIRED in production; 10+ character password)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=
# Optional alternative: a werkzeug password hash instead of the plain password
# ADMIN_PASSWORD_HASH=

# Exams on offer. WAEC mocks/practice show "Coming soon" until you set this to 1
# (do it after uploading the genuine WAEC question bank). Post-UTME opens automatically
# once Post-UTME questions exist.
WAEC_ENABLED=0

# Landing-page countdown target (YYYY-MM-DD). Leave empty to assume mid-April of the coming cycle.
NEXT_UTME_DATE=

# Sessions
SESSION_IDLE_MINUTES=60
# Keep 1 behind HTTPS (production). Set 0 only for plain-http local testing.
SESSION_COOKIE_SECURE=1

# E-mail for verification, password reset and receipts.
# Leave MAIL_USERNAME/MAIL_PASSWORD blank to disable e-mail; new accounts are then
# auto-verified so students are never locked out.  Gmail: use an App Password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_NAME=PrepNova CBT

# Paystack keys: https://dashboard.paystack.com/#/settings/developers
# Use pk_test_/sk_test_ while testing, pk_live_/sk_live_ when going live.
# Register this webhook URL in Paystack:  https://your-domain.com/paystack/webhook
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Support contacts shown across the site (WhatsApp: digits only, international format)
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_WHATSAPP=2348000000000
