# ---------------------------------------------------------------------------
# PrepNova CBT — environment configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=production                    # use "development" locally (relaxes secure-cookie + placeholder checks)
SECRET_KEY=                             # REQUIRED in production: python -c "import secrets; print(secrets.token_hex(32))"
APP_URL=https://your-domain.com         # public URL, used in e-mails and Paystack callbacks
PORT=5000
DATABASE_PATH=database.db               # absolute path recommended on a persistent disk in production

# Administrator (the login form at /admin_login)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=                         # strong password (app refuses to start in production with admin123 etc.)
# ADMIN_PASSWORD_HASH=                  # optional: a werkzeug password hash instead of the plain password

# Sessions
SESSION_IDLE_MINUTES=60
SESSION_COOKIE_SECURE=1                 # keep 1 behind HTTPS

# E-mail (verification, password reset, receipts). Leave blank to disable e-mail;
# new accounts are then auto-verified so students are not locked out.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=                          # Gmail: use an App Password
MAIL_SENDER_NAME=PrepNova CBT

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_SECRET_KEY=sk_live_xxx
# Webhook URL to register in Paystack: https://your-domain.com/paystack/webhook

# Support contacts shown across the site
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_WHATSAPP=2348000000000          # digits only, international format
